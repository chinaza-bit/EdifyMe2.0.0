# Dependencies — regenerated by "npm install", never commit these
node_modules/

# Secrets — never commit your real .env (contains DB password, JWT secret, email keys)
.env
.env.local
.env.example
.env.*.local

# Logs
npm-debug.log*
*.log

# OS/editor clutter
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Prisma
backend/prisma/migrations/dev.db

# Build/output folders (if you add any later)
dist/
build/
